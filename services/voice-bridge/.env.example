# EA voice bridge env. The real file lives at /etc/ea/env (chmod 600, owned by paperclip).
# Nothing here is committed with real values. Paperclip skills read the SAME names
# via projectEnv bindings in ../../.paperclip.yaml.

# --- Bridge ---
PORT=5050
EA_PUBLIC_HOST=ea.example.com          # the Cloudflare Tunnel hostname
ALLOWED_CALLER_E164=+1XXXXXXXXXX        # Ryan's phone; the ONLY caller allowed
MAX_CALL_SECONDS=1800                   # hard per-call ceiling (30 min)
MAX_TOOLS_PER_CALL=20
EA_BRIDGE_DB=/var/lib/ea-voice-bridge/session.sqlite
EA_INTERNAL_TOKEN=change-me            # guards the loopback /trigger-callback route

# --- Gemini Live ---
# NOTE: systemd EnvironmentFile does NOT strip inline "# comments" — keep comments
# on their own lines, never after a value, or the comment leaks into the value.
GEMINI_API_KEY=
# Voice options: Charon (calm M), Aoede (warm F), Kore (alt F)
GEMINI_VOICE=Charon
# Only the native-audio Live model is available on the current key; the older
# gemini-2.5-flash-live-preview / gemini-2.0-flash-live-001 names 404 on BidiGenerateContent.
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-09-2025

# --- Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
BOARD_PHONE=+1XXXXXXXXXX

# --- Microsoft Graph (delegated OAuth on Ryan's M365 Business account) ---
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=

# --- Paperclip API ---
PAPERCLIP_API_URL=http://127.0.0.1:3100
PAPERCLIP_API_TOKEN=
EA_COMPANY_SLUG=ea

# --- Contacts + vault ---
EA_CONTACTS_PATH=/etc/ea/contacts.json
EA_VAULT_REPO_PATH=/var/lib/ea-voice-bridge/vault
EA_VAULT_GIT_REMOTE=git@github.com:Rfog88/ea-vault.git

# --- Notifications ---
BOARD_DND_HOURS=22-07                   # optional; Tier-1 holds inside window, Tier-2 always fires
